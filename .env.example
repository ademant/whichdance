# Copy to .env and fill in (`.env` is gitignored, never commit real
# credentials). FUNKWHALE_TOKEN is the OAuth access token for a Funkwhale
# Application (Settings > Applications) with read access to your
# library/playlists; sent as a Bearer token, your password is never used.

FUNKWHALE_URL=https://music.example.org
FUNKWHALE_TOKEN=

# Optional: local directory (e.g. an sshfs mount of Funkwhale's
# media/music folder) to read audio directly from instead of downloading
# each track over HTTP. Falls back to download automatically for any
# track that isn't found there.
FUNKWHALE_MEDIA_ROOT=
